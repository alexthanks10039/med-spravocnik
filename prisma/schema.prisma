generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  @@index([role])
}

model Drug {
  id                String   @id @default(cuid())
  name              String
  internationalName String?
  form              String?
  dosage            String?
  indications       String?
  contraindications String?
  sideEffects       String?
  analogs           String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([internationalName])
}

model Disease {
  id          String   @id @default(cuid())
  name        String
  icd10       String?
  symptoms    String?
  diagnostics String?
  treatment   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([icd10])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  description String?
  content     String
  tags        String[] @default([])
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished, updatedAt])
}


enum DataRecordStatus {
  ACTIVE
  ARCHIVED
}

model DataCollection {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  schema      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     DataRecord[]
  imports     DataImport[]
}

model DataRecord {
  id           String            @id @default(cuid())
  collectionId String
  externalId   String
  title        String?
  recordType   String?
  searchText   String?
  payload      Json
  status       DataRecordStatus  @default(ACTIVE)
  version      Int               @default(1)
  sourceFile   String?
  checksum     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  collection   DataCollection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, externalId])
  @@index([collectionId, status, updatedAt])
  @@index([collectionId, title])
  @@index([collectionId, recordType])
}

model DataImport {
  id           String         @id @default(cuid())
  collectionId String
  filename     String?
  format       String
  status       String
  total        Int            @default(0)
  imported     Int            @default(0)
  rejected     Int            @default(0)
  errors       Json?
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  collection   DataCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, startedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
}
